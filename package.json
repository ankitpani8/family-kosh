{
  "name": "family-kosh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Family money ledger: individual and family net worth, holdings in any unit, monthly cash flow, an allocation engine and a strategy simulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@supabase/supabase-js": "2.119.0",
    "idb-keyval": "6.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "pg": "^8.16.3",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "3.2.7"
  }
}
